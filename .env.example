# Copy this file to .env and fill in your real values.
# Never commit .env to git — it's in .gitignore.

# ── Telegram (required) ───────────────────────────────────────────────────
# Get these at https://my.telegram.org → API Development Tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+91xxxxxxxxxx

# ── Groq (required if LLM_BACKEND = "groq") ──────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_

# ── Kite Connect (required for order execution) ───────────────────────────
# Create a Personal app at https://kite.trade/apps
# Set Redirect URL to: http://127.0.0.1:8000/kite/callback
KITE_API_KEY=
KITE_API_SECRET=

# ── Auto-filled by dashboard after daily login — do not edit manually ─────
KITE_ACCESS_TOKEN=
